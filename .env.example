# Firebase Auth config for Auditify sign-in (Google + email/password).
# Copy to .env.local for local dev. In production, set these in the Vercel
# project's Environment Variables and redeploy. Never commit real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
